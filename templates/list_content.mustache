{{!
    @template local_groundedai/list_content

    The grouped conversation list.

    Context variables required for this template:
    * groups - array of {label, items:[{id, name, archived}]}
    * empty - bool

    Example context (json):
    {
        "empty": false,
        "groups": [
            {"label": "Today", "items": [{"id": 1, "name": "Late policy", "archived": false}]}
        ]
    }
}}
{{#empty}}
    <p class="gai-empty text-muted">{{#str}}nochats, local_groundedai{{/str}}</p>
{{/empty}}
{{#groups}}
    <div class="gai-group-label">{{label}}</div>
    {{#items}}
        <div class="gai-conv-row" data-conv-id="{{id}}">
            <button type="button" class="gai-conv-open" data-conv-open="{{id}}" title="{{name}}">{{name}}</button>
            <div class="gai-conv-menu">
                <button type="button" class="gai-conv-dots" data-conv-menu="{{id}}"
                        aria-haspopup="menu" aria-expanded="false"
                        aria-label="{{#str}}moreactions, local_groundedai{{/str}}"
                        title="{{#str}}moreactions, local_groundedai{{/str}}">&#8943;</button>
                <div class="gai-conv-dropdown" role="menu" hidden>
                    <button type="button" class="gai-conv-item" role="menuitem"
                            data-conv-action="rename" data-id="{{id}}">{{#str}}rename, local_groundedai{{/str}}</button>
                    {{^archived}}
                        <button type="button" class="gai-conv-item" role="menuitem"
                                data-conv-action="archive" data-id="{{id}}">{{#str}}archive, local_groundedai{{/str}}</button>
                    {{/archived}}
                    {{#archived}}
                        <button type="button" class="gai-conv-item" role="menuitem"
                                data-conv-action="unarchive" data-id="{{id}}">{{#str}}unarchive, local_groundedai{{/str}}</button>
                    {{/archived}}
                    <button type="button" class="gai-conv-item gai-conv-item-danger" role="menuitem"
                            data-conv-action="delete" data-id="{{id}}">{{#str}}delete, local_groundedai{{/str}}</button>
                </div>
            </div>
        </div>
    {{/items}}
{{/groups}}
