{{!
    @template local_groundedai/panel_content

    The message log for one conversation.

    Context variables required for this template:
    * messages - array of {role, rolelabel, content, hassources, sources:[{n, name, url}]}
    * empty - bool
    * hasmore - bool

    Example context (json):
    {
        "empty": false,
        "hasmore": false,
        "messages": [
            {"role": "assistant", "rolelabel": "Tutor", "content": "Late work loses 5 points a day.",
             "hassources": true, "sources": [{"n": 1, "name": "Course handbook", "url": "https://example.com"}]}
        ]
    }
}}
{{#empty}}
    <p class="gai-empty text-muted">{{#str}}startchat, local_groundedai{{/str}}</p>
{{/empty}}
{{#hasmore}}
    <button type="button" class="gai-loadmore btn btn-link btn-sm" data-action="gai-loadmore">
        {{#str}}moremessages, local_groundedai{{/str}}
    </button>
{{/hasmore}}
{{#messages}}
    <div class="gai-msg gai-msg-{{role}}">
        <div class="sr-only">{{rolelabel}}</div>
        {{#hasactions}}
            <div class="gai-msg-actions" aria-label="{{#str}}actionstaken, local_groundedai{{/str}}">
                {{#actions}}<span class="gai-action-chip">{{label}}</span>{{/actions}}
            </div>
        {{/hasactions}}
        {{#hashtml}}<div class="gai-msg-content">{{{contenthtml}}}</div>{{/hashtml}}
        {{^hashtml}}<div class="gai-msg-content">{{content}}</div>{{/hashtml}}
        {{#hassources}}
            <div class="gai-msg-sources">
                <span class="gai-sources-label">{{#str}}sources, local_groundedai{{/str}}</span>
                {{#sources}}<a href="{{url}}" target="_blank" rel="noopener noreferrer">[{{n}}] {{name}}</a>{{/sources}}
            </div>
        {{/hassources}}
    </div>
{{/messages}}
