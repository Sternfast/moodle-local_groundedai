{{!
    @template local_groundedai/attachments_content

    The attach-file control and the current conversation's attachment chips.

    Context variables required for this template:
    * attachments - array of {id, filename, statuslabel, isdone, iserror, ispending}
    * hasattachments - bool
    * busy - bool (an upload is in flight)

    Example context (json):
    {
        "hasattachments": true,
        "busy": true,
        "attachments": [
            {"id": 7, "filename": "roster.xlsx", "statuslabel": "Ready", "isdone": true, "iserror": false, "ispending": false}
        ]
    }
}}
{{#busy}}<span class="gai-attach-uploading text-muted">{{#str}}uploading, local_groundedai{{/str}}</span>{{/busy}}
{{#hasattachments}}
<ul class="gai-chips" aria-label="{{#str}}domainupload, local_groundedai{{/str}}">
    {{#attachments}}
    <li class="gai-chip {{#isdone}}gai-chip-done{{/isdone}}{{#iserror}}gai-chip-error{{/iserror}}{{#ispending}}gai-chip-pending{{/ispending}}">
        <span class="gai-chip-name">{{filename}}</span>
        <span class="gai-chip-status">{{statuslabel}}</span>
        <button type="button" class="gai-chip-remove" data-action="gai-remove-attach" data-id="{{id}}"
                aria-label="{{#str}}attachremove, local_groundedai{{/str}}">&times;</button>
    </li>
    {{/attachments}}
</ul>
{{/hasattachments}}
