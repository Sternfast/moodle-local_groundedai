{{!
    @template local_groundedai/panel_pending

    An optimistic user turn plus a typing indicator shown while the reply is in flight.

    Context variables required for this template:
    * text - the user's message
    * youlabel - the learner's role label
    * thinking - the typing-indicator screen-reader text

    Example context (json):
    {"text": "When is it due?", "youlabel": "You", "thinking": "Thinking"}
}}
<div class="gai-msg gai-msg-user gai-pending">
    <div class="sr-only">{{youlabel}}</div>
    <div class="gai-msg-content">{{text}}</div>
</div>
<div class="gai-msg gai-msg-assistant gai-typing" role="status">
    <div class="gai-msg-content">
        <span class="gai-dot"></span><span class="gai-dot"></span><span class="gai-dot"></span>
        <span class="sr-only">{{thinking}}</span>
    </div>
</div>
